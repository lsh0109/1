<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>五十音前十五音測驗 (あ - そ)</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        body {
            background-color: #f4f7f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .quiz-card {
            background: #ffffff;
            width: 100%;
            max-width: 480px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            padding: 28px;
            text-align: center;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            font-size: 14px;
            color: #666;
            font-weight: bold;
        }

        .progress-bar-container {
            width: 100%;
            height: 6px;
            background-color: #e2e8f0;
            border-radius: 3px;
            overflow: hidden;
            margin-bottom: 24px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background-color: #4a90e2;
            transition: width 0.3s ease;
        }

        .char-display {
            font-size: 80px;
            font-weight: bold;
            color: #2c3e50;
            margin: 20px 0 30px;
            line-height: 1;
        }

        .options-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 24px;
        }

        .btn-option {
            background-color: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 14px;
            font-size: 18px;
            font-weight: 600;
            color: #334155;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-option:hover:not(:disabled) {
            background-color: #edf2f7;
            border-color: #cbd5e1;
            transform: translateY(-1px);
        }

        .btn-option:disabled {
            cursor: not-allowed;
        }

        .btn-option.correct {
            background-color: #d1fae5 !important;
            border-color: #10b981 !important;
            color: #065f46 !important;
        }

        .btn-option.wrong {
            background-color: #fee2e2 !important;
            border-color: #ef4444 !important;
            color: #991b1b !important;
        }

        .feedback {
            height: 24px;
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .feedback.correct { color: #10b981; }
        .feedback.wrong { color: #ef4444; }

        .btn-next, .btn-restart {
            background-color: #4a90e2;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 12px 28px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .btn-next:hover, .btn-restart:hover {
            background-color: #357abd;
        }

        .hidden {
            display: none !important;
        }

        .result-score {
            font-size: 48px;
            font-weight: bold;
            color: #2c3e50;
            margin: 20px 0;
        }
    </style>
</head>
<body>

    <div class="quiz-card">
        <!-- 測驗區域 -->
        <div id="quiz-screen">
            <div class="header">
                <span id="question-count">題目 1 / 15</span>
                <span id="score-count">得分: 0</span>
            </div>
            <div class="progress-bar-container">
                <div class="progress-bar" id="progress-bar"></div>
            </div>

            <div class="char-display" id="char-display">あ</div>

            <div class="options-grid" id="options-container">
                <!-- 選項按鈕動態生成 -->
            </div>

            <div class="feedback" id="feedback"></div>

            <button class="btn-next hidden" id="next-btn" onclick="nextQuestion()">下一題</button>
        </div>

        <!-- 結算頁面 -->
        <div id="result-screen" class="hidden">
            <h2>測驗完成！</h2>
            <div class="result-score" id="final-score">0 / 15</div>
            <p id="result-comment" style="color: #64748b; margin-bottom: 28px;"></p>
            <button class="btn-restart" onclick="startQuiz()">再測一次</button>
        </div>
    </div>

    <script>
        // 前 15 個五十音資料 (あ ~ そ)
        const kanaData = [
            { kana: 'あ', romaji: 'a' },
            { kana: 'い', romaji: 'i' },
            { kana: 'う', romaji: 'u' },
            { kana: 'え', romaji: 'e' },
            { kana: 'お', romaji: 'o' },
            { kana: 'か', romaji: 'ka' },
            { kana: 'き', romaji: 'ki' },
            { kana: 'く', romaji: 'ku' },
            { kana: 'け', romaji: 'ke' },
            { kana: 'こ', romaji: 'ko' },
            { kana: 'さ', romaji: 'sa' },
            { kana: 'し', romaji: 'shi' },
            { kana: 'す', romaji: 'su' },
            { kana: 'せ', romaji: 'se' },
            { kana: 'そ', romaji: 'so' }
        ];

        let questions = [];
        let currentQuestionIndex = 0;
        let score = 0;

        function shuffle(array) {
            return [...array].sort(() => Math.random() - 0.5);
        }

        function startQuiz() {
            questions = shuffle(kanaData);
            currentQuestionIndex = 0;
            score = 0;
            
            document.getElementById('quiz-screen').classList.remove('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            
            showQuestion();
        }

        function showQuestion() {
            const currentItem = questions[currentQuestionIndex];
            
            // 更新 UI 資訊
            document.getElementById('question-count').textContent = `題目 ${currentQuestionIndex + 1} / ${questions.length}`;
            document.getElementById('score-count').textContent = `得分: ${score}`;
            document.getElementById('progress-bar').style.width = `${((currentQuestionIndex) / questions.length) * 100}%`;
            document.getElementById('char-display').textContent = currentItem.kana;
            document.getElementById('feedback').textContent = '';
            document.getElementById('feedback').className = 'feedback';
            document.getElementById('next-btn').classList.add('hidden');

            // 生成選項（1 個正確答案 + 3 個隨機干擾項）
            const wrongOptions = kanaData.filter(item => item.romaji !== currentItem.romaji);
            const selectedWrong = shuffle(wrongOptions).slice(0, 3);
            const allOptions = shuffle([currentItem, ...selectedWrong]);

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            allOptions.forEach(option => {
                const button = document.createElement('button');
                button.className = 'btn-option';
                button.textContent = option.romaji;
                button.onclick = () => selectOption(button, option.romaji, currentItem.romaji);
                optionsContainer.appendChild(button);
            });
        }

        function selectOption(selectedBtn, selectedRomaji, correctRomaji) {
            const buttons = document.querySelectorAll('.btn-option');
            buttons.forEach(btn => btn.disabled = true); // 鎖定所有按鈕

            const feedback = document.getElementById('feedback');

            if (selectedRomaji === correctRomaji) {
                selectedBtn.classList.add('correct');
                feedback.textContent = '正確！ 🎉';
                feedback.classList.add('correct');
                score++;
            } else {
                selectedBtn.classList.add('wrong');
                feedback.textContent = `錯誤，正確答案是 "${correctRomaji}"`;
                feedback.classList.add('wrong');
                
                // 標示出正確答案
                buttons.forEach(btn => {
                    if (btn.textContent === correctRomaji) {
                        btn.classList.add('correct');
                    }
                });
            }

            document.getElementById('score-count').textContent = `得分: ${score}`;
            document.getElementById('next-btn').classList.remove('hidden');
        }

        function nextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < questions.length) {
                showQuestion();
            } else {
                showResult();
            }
        }

        function showResult() {
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');
            
            document.getElementById('final-score').textContent = `${score} / ${questions.length}`;
            
            const comment = document.getElementById('result-comment');
            if (score === 15) {
                comment.textContent = '太棒了！完全掌握前 15 個五十音！ 👏';
            } else if (score >= 10) {
                comment.textContent = '表現不錯，再多練習幾次就能滿分囉！';
            } else {
                comment.textContent = '繼續努力，多記幾遍很快就能熟練了！💪';
            }
        }

        // 初始化開始測驗
        startQuiz();
    </script>
</body>
</html>
